# Copy to `.env` in this same directory. Vite only exposes vars prefixed
# `VITE_` to client code — see src/api/config.js and src/push/usePushSubscription.js.

# Leave unset for local dev — vite.config.js's proxy forwards /api to
# localhost:8000 automatically. Set to the deployed backend's full URL
# (e.g. https://api.yourdomain.com/api) for a production build.
VITE_API_BASE_URL=

# Must match backend/.env's VAPID_PUBLIC_KEY exactly (same keypair, this is
# just the public half exposed to the browser). Generate both together with:
#   npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Error monitoring — leave empty to disable entirely (src/sentry.js no-ops
# without it). Create a free project at sentry.io (Platform: React) to get
# a DSN.
VITE_SENTRY_DSN=
