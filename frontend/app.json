{
  "expo": {
    "name": "Stack",
    "slug": "stack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "stack",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stack.app"
    },
    "android": {
      "package": "com.stack.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFEB97",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#A8551C"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Stack uses your microphone to turn spoken tasks into text.",
          "speechRecognitionPermission": "Stack uses speech recognition to turn your voice into task text.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.tts"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0e82186d-8b4c-49b0-8eae-f5e54da1f073"
      }
    },
    "owner": "amens-team"
  }
}
