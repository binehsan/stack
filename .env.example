# Read by docker-compose.yml itself (not by Django — see backend/.env.example
# for those vars). Copy to `.env` in this same directory on the VPS.
# (DOMAIN isn't needed here anymore — the system nginx owns the domain now,
# see deploy/nginx/stack.conf — but it's still what backend/.env's
# DJANGO_ALLOWED_HOSTS should be set to.)

# Shared between the `postgres` service (creates this user/db on first boot)
# and `backend` (connects with them) — see docker-compose.yml's top comment
# for why these live here and not in backend/.env.
POSTGRES_DB=stack
POSTGRES_USER=stack
POSTGRES_PASSWORD=change-me
