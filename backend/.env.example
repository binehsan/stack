# Copy this file to `.env` in the same directory (backend/.env) and fill in
# real values. `.env` is gitignored — never commit real secrets. Loaded
# automatically by config/settings.py via python-dotenv; every value here
# has a dev-safe fallback if unset, so local dev works without a .env at all.

# --- Django core -------------------------------------------------------
# Leave DJANGO_DEBUG / DJANGO_ALLOWED_HOSTS / CORS_ALLOWED_ORIGINS unset (or
# delete the lines) while testing locally — the defaults already work for
# localhost. Only set them once you have a real domain on your VPS.
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database -------------------------------------------------------------
# Deliberately NOT here for the Docker deploy path — POSTGRES_DB/USER/
# PASSWORD live in the repo root's .env.example instead (docker-compose.yml
# injects them into this container directly), and POSTGRES_HOST is always
# just "postgres" there, hardcoded in docker-compose.yml, not a secret.
# Leave all of this unset for plain `venv`/`runserver` dev — settings.py
# falls back to SQLite automatically. Only set these here yourself if you
# want your bare venv workflow to talk to a real Postgres too (e.g. one you
# started with `docker compose up postgres` and exposed on localhost) —
# in that case POSTGRES_HOST=localhost, since you're not inside the
# Docker network in that scenario.
# POSTGRES_DB=stack
# POSTGRES_USER=stack
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Email (password reset, and any future transactional email) --------
# Leave EMAIL_BACKEND unset while testing locally — Django's console backend
# just prints the email to the runserver terminal instead of sending it, so
# you can test the whole reset flow without real credentials. Switch to the
# smtp backend + fill in the rest once you have real provider credentials.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Stack <noreply@yourdomain.com>

# The website's own URL — used to build links inside emails (e.g. the
# password reset link) and to load the logo image from website/public/.
FRONTEND_URL=https://yourdomain.com

# --- Web Push (PWA notifications) ---------------------------------------
# Generate once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY's value also goes in PWA/.env as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# --- Error monitoring ----------------------------------------------------
# Leave empty to disable entirely. sentry.io free project (Platform: Django).
SENTRY_DSN=
