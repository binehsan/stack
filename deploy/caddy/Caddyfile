{$DOMAIN} {
	encode gzip

	# Full path preserved on purpose — Django's urls.py mounts everything
	# under the literal /api/ prefix (config/urls.py), unlike the static/
	# media handlers below which strip their prefix.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}

	# Django-collected static (admin CSS/JS) and user-uploaded avatars —
	# both volume-mounted from the backend container, see docker-compose.yml.
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# The React SPA, baked into this image at build time. try_files falls
	# back to index.html so client-side routes (e.g. /dashboard) don't 404
	# on a hard refresh.
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
